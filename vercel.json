{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://setu-maritime-production.up.railway.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
